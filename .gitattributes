# Texto en LF para que Biome/CI en Windows no fallen por CRLF
* text=auto eol=lf

# Scripts de Windows: CRLF es el nativo
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.ico binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.db binary
*.exe binary
